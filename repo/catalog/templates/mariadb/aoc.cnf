# ============================================================
# auto-ops-console 管理 · MariaDB 服务端配置
# ------------------------------------------------------------
# 由配方 `mariadb` 渲染。★ 这个文件由配方管 —— 手改会在下次部署被覆盖。
# ★ 我们只写**这一个**文件，不动 /etc/my.cnf.d/ 里包自带的那些（规范 §12.13.3）。
# ★ 内容没变就不写盘（规范 §12.4：sha256 相同则不写）—— 幂等靠这个成立。
# ============================================================

[mysqld]
# ---- 监听 ----
port            = {{ port }}
bind-address    = {{ bind }}

# ---- 连接 ----
max_connections = {{ max_connections }}

# ---- 字符集（服务端）----
character-set-server = {{ charset }}
collation-server     = {{ charset }}_general_ci

# ---- 内存 ----
# ★ 靶机内存只有 3.6G，MariaDB 的 innodb_buffer_pool_size 默认值偏大，
#   这里显式压到参数值（默认 128M）；调大之前先想清楚这台机器还有谁在跑。
#   （T6 开题单 §9.2 #10）
innodb_buffer_pool_size = {{ buffer_pool_mb }}M
