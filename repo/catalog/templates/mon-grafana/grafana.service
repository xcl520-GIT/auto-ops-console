[Unit]
Description=AOC Monitoring · Grafana
Documentation=https://grafana.com/docs/grafana/latest/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aocmon
Group=aocmon
WorkingDirectory=/opt/aoc-monitoring/grafana
ExecStart=/opt/aoc-monitoring/grafana/bin/grafana server --homepath=/opt/aoc-monitoring/grafana --config=/opt/aoc-monitoring/etc/grafana.ini
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
